# CognoDB
COGNODB_URI=bolt+s://db-xxx.databases.cognodb.com:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_password_here

# Neo4j Aura
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# FalkorDB
FALKORDB_HOST=your_falkordb_host_here
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_password_here

# TypeDB
TYPEDB_HOST=your_typedb_host_here
TYPEDB_PORT=443
TYPEDB_USER=admin
TYPEDB_PASSWORD=your_password_here
TYPEDB_DATABASE=your_database_here

# NebulaGraph
NEBULA_HOST=your_nebula_host_here
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=your_password_here
NEBULA_SPACE=your_space_here
